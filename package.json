{
  "name": "deepseek-harness-vscode",
  "displayName": "DeepSeek Harness",
  "description": "DeepSeek Harness integration for VS Code with Remote SSH support.",
  "version": "0.2.0-alpha.1",
  "publisher": "plutoczm",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["Machine Learning", "Programming Languages", "Other"],
  "keywords": ["deepseek", "harness", "agent", "coding-agent", "remote-ssh"],
  "activationEvents": [
    "onView:deepseekHarness.chatView",
    "onCommand:deepseekHarness.setApiKey",
    "onCommand:deepseekHarness.newSession",
    "onCommand:deepseekHarness.interrupt",
    "onCommand:deepseekHarness.addSelection",
    "onCommand:deepseekHarness.addCurrentFile",
    "onCommand:deepseekHarness.addProblems",
    "onCommand:deepseekHarness.fixSelection",
    "onCommand:deepseekHarness.explainSelection"
  ],
  "main": "./dist/extension.js",
  "extensionKind": ["workspace"],
  "contributes": {
    "commands": [
      {"command": "deepseekHarness.setApiKey", "title": "DeepSeek Harness: Set API Key"},
      {"command": "deepseekHarness.newSession", "title": "DeepSeek Harness: New Session"},
      {"command": "deepseekHarness.interrupt", "title": "DeepSeek Harness: Interrupt Current Run"},
      {"command": "deepseekHarness.installRuntime", "title": "DeepSeek Harness: Install/Upgrade Runtime"},
      {"command": "deepseekHarness.addSelection", "title": "DeepSeek Harness: Add Selection to Context"},
      {"command": "deepseekHarness.addCurrentFile", "title": "DeepSeek Harness: Add File to Context"},
      {"command": "deepseekHarness.addProblems", "title": "DeepSeek Harness: Add Problems to Context"},
      {"command": "deepseekHarness.fixSelection", "title": "DeepSeek Harness: Fix Selected Code"},
      {"command": "deepseekHarness.explainSelection", "title": "DeepSeek Harness: Explain Selected Code"}
    ],
    "menus": {
      "editor/context": [
        {
          "command": "deepseekHarness.fixSelection",
          "when": "editorHasSelection",
          "group": "1_modification@90"
        },
        {
          "command": "deepseekHarness.explainSelection",
          "when": "editorHasSelection",
          "group": "1_modification@91"
        },
        {
          "command": "deepseekHarness.addSelection",
          "when": "editorHasSelection",
          "group": "1_modification@92"
        }
      ],
      "explorer/context": [
        {
          "command": "deepseekHarness.addCurrentFile",
          "when": "resourceScheme == file",
          "group": "4_search@90"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseekHarness",
          "title": "DeepSeek Harness",
          "icon": "media/deepseek.svg"
        }
      ]
    },
    "views": {
      "deepseekHarness": [
        {
          "type": "webview",
          "id": "deepseekHarness.chatView",
          "name": "Agent"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "deepseekHarness.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python executable used to run the DeepSeek Harness bridge on the workspace host."
        },
        "deepseekHarness.model": {
          "type": "string",
          "default": "deepseek-v4-pro",
          "enum": ["deepseek-v4-pro", "deepseek-v4-flash"],
          "description": "DeepSeek model used by the Harness runtime."
        },
        "deepseekHarness.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "DeepSeek API base URL."
        },
        "deepseekHarness.maxTokens": {
          "type": "number",
          "default": 49152,
          "minimum": 1,
          "description": "Per-request output-token cap passed to DeepSeek Harness."
        },
        "deepseekHarness.maxContextChars": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 500000,
          "description": "Maximum characters captured for each VS Code context item before truncation."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "npm run compile && vsce package",
    "check": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.8.0"
  }
}
