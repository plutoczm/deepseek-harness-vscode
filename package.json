{
  "name": "dsh-ssh-vpn-bridge",
  "version": "0.1.0",
  "description": "DeepSeek Harness SSH remote workspaces with automatic Windows local-proxy/VPN fallback through an SSH reverse tunnel.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-ssh-remote": "github:CrazyShout/dsh-ssh-remote#72a2ac6b0f277ab0706ee93634dee2c639070728"
  },
  "scripts": {
    "check": "node --check src/util.js && node --check src/network.js && node --check src/openssh-transport.js && node --check src/process.js && node --check src/terminal.js && node --check src/index.js",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ssh",
    "remote",
    "vpn",
    "proxy",
    "clash",
    "mihomo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutoczm/deepseek-harness-vscode.git"
  }
}
