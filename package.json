{
  "name": "dsh-openssh-vpn",
  "version": "0.3.0",
  "description": "DeepSeek Harness native OpenSSH remote tools and Web SSH panel with direct-first GitHub routing and Windows VPN RemoteForward reuse/fallback.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "WINDOWS-TEST.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check src/util.js && node --check src/openssh.js && node --check src/network.js && node --check src/engine.js && node --check src/tools.js && node --check src/index.js && node --check client.js",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "openssh",
    "ssh",
    "terminal",
    "remote",
    "vpn",
    "proxy",
    "clash",
    "mihomo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutoczm/deepseek-harness-vscode.git"
  }
}
